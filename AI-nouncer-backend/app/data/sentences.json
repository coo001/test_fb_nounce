[
  {"id": "s1",  "text": "삼촌은 신선한 생선을 사셨다",         "length_tier": "short", "target_patterns": ["S_SERIES_UNCLEAR"]},
  {"id": "s2",  "text": "사슴 다섯 마리가 산을 달린다",         "length_tier": "short", "target_patterns": ["S_SERIES_UNCLEAR", "FINAL_CONSONANT_DROP"]},
  {"id": "s3",  "text": "쌀을 씻기 전에 손을 씻어 주세요",      "length_tier": "short", "target_patterns": ["S_SERIES_UNCLEAR"]},
