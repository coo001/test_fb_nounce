{
  "version": "0.1.0",
  "source": "한국어 L2 발음 교재 기반 시드 카탈로그 (좁은 6패턴)",
  "patterns": [
    {
      "id": "S_SERIES_UNCLEAR",
      "name_ko": "ㅅ 계열 불명확",
      "definition": "초성 ㅅ/ㅆ이 영어 s/sh 또는 다른 마찰·파찰음으로 흐릿하게 들리는 현상. 한국어 학습자가 모국어의 마찰음 체계로 대체할 때 발생.",
      "examples": [
        {"expected": "사슴", "heard": "자슴"},
        {"expected": "신선한", "heard": "신전한"},
        {"expected": "씻기", "heard": "지기"}
      ],
      "rule_signature": {
        "scope": "cho",
        "expected_in": ["ㅅ", "ㅆ"],
        "heard_not_in": ["ㅅ", "ㅆ"]
      }
    },
    {
      "id": "FINAL_CONSONANT_DROP",
      "name_ko": "종성 약화/탈락",
      "definition": "원문 음절에 받침(종성)이 있는데 청자가 받침을 인식하지 못한 경우. 종성을 약하게 닫거나 후행 음절로 이어 발음할 때 발생.",
      "examples": [
        {"expected": "산", "heard": "사"},
        {"expected": "봄바람", "heard": "보바람"},
        {"expected": "달린다", "heard": "다린다"}
      ],
      "rule_signature": {
        "scope": "jong",
        "expected_present": true,
        "heard_present": false
      }
    },
    {
      "id": "TENSE_LAX_CONFUSION",
      "name_ko": "평음·경음 혼동",
      "definition": "평음(ㄱ/ㄷ/ㅂ/ㅈ/ㅅ)과 경음(ㄲ/ㄸ/ㅃ/ㅉ/ㅆ)을 구분하지 못해 양 방향으로 바꿔 인식되는 현상. L2 학습자에게 가장 흔한 자음 대비 오류 중 하나.",
      "examples": [
        {"expected": "까치", "heard": "가치"},
        {"expected": "쌀", "heard": "살"},
        {"expected": "방", "heard": "빵"}
      ],
      "rule_signature": {
        "scope": "cho",
        "pairs": [["ㄱ", "ㄲ"], ["ㄷ", "ㄸ"], ["ㅂ", "ㅃ"], ["ㅈ", "ㅉ"], ["ㅅ", "ㅆ"]]
      }
    },
    {
      "id": "ASPIRATION_WEAK",
      "name_ko": "격음 약화",
      "definition": "격음(ㅋ/ㅌ/ㅍ/ㅊ)이 평음(ㄱ/ㄷ/ㅂ/ㅈ)으로 약화되어 들리는 현상. 호기(aspiration) 부족이 원인.",
      "examples": [
        {"expected": "카페", "heard": "가배"},
        {"expected": "탁구", "heard": "닥구"},
        {"expected": "출발", "heard": "줄발"}
      ],
      "rule_signature": {
        "scope": "cho",
        "directed_pairs": [["ㅋ", "ㄱ"], ["ㅌ", "ㄷ"], ["ㅍ", "ㅂ"], ["ㅊ", "ㅈ"]]
      }
    },
    {
      "id": "VOWEL_EO_O",
      "name_ko": "ㅓ·ㅗ 모음 혼동",
      "definition": "중성 ㅓ와 ㅗ를 구분하지 못해 양 방향으로 바꿔 인식되는 현상. 영어권/일어권 학습자에게 매우 흔함.",
      "examples": [
        {"expected": "어머니", "heard": "오머니"},
        {"expected": "오빠", "heard": "어빠"},
        {"expected": "선생님", "heard": "손생님"}
      ],
      "rule_signature": {
        "scope": "jung",
        "pairs": [["ㅓ", "ㅗ"]]
      }
    },
    {
      "id": "LIQUID_NASAL",
      "name_ko": "ㄹ·ㄴ 유음·비음 혼동",
      "definition": "ㄹ과 ㄴ을 구분하지 못해 양 방향으로 바꿔 인식되는 현상. 특히 일어권 학습자에서 흔하며, 한국어 음운 환경 차이로 인한 변별 어려움.",
      "examples": [
        {"expected": "라면", "heard": "나면"},
        {"expected": "나무", "heard": "라무"},
        {"expected": "딸", "heard": "딴"}
      ],
      "rule_signature": {
        "scope": "cho_or_jong",
        "pairs": [["ㄹ", "ㄴ"]]
      }
    }
  ]
}
